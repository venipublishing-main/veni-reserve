{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vf-reserve-dev",
  "compatibility_date": "2026-10-06",
  "main": "./workers/app.ts",
  "vars": {
    "VENI_PRODUCT": "reserve",
    "VENI_ENV": "dev"
  },
  "env": {
    "stg": {
      "name": "vf-reserve-stg",
      "workers_dev": true,
      "preview_urls": false,
      "vars": {
        "VENI_PRODUCT": "reserve",
        "VENI_ENV": "stg",
        "VENI_ACCOUNT_MODE": "shared",
        "SUPABASE_URL": "https://droslqfcazwkwvqlbtsq.supabase.co",
        "SUPABASE_PUBLISHABLE_KEY": "sb_publishable_v7dkG118DobqayECLngcbA_DUuO4ZAc"
      }
    },
    "app_preview": {
      "name": "vf-reserve-app-preview",
      "account_id": "c71916b32e9e18b2271be2b081c4f927",
      "workers_dev": true,
      "preview_urls": false,
      "observability": {
        "enabled": false
      },
      "assets": {
        "run_worker_first": true,
        "binding": "ASSETS"
      },
      "vars": {
        "VENI_PRODUCT": "reserve",
        "VENI_ENV": "app_preview"
      }
    }
  }
}
